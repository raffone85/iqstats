# Dati grezzi e dataset derivati: non entrano nel repository.
# Sono centinaia di megabyte e sono ricostruibili con gli script che stanno qui accanto.
# Attenzione: NON sono in alcun backup. Non cancellarli e non usare git clean.
scripts/projection/harvest/data/
scripts/projection/dataset/output/features/
scripts/projection/dataset/output/*.csv
# Lotti delle osservazioni per il database: 125 MB rigenerabili in un minuto.
scripts/projection/dataset/output/lotti-osservazioni/

# Il caricamento dei due tempi: dati generati dall'archivio, non sorgente.
scripts/app-ingestion/output/

scripts/calibration/data/
scripts/calibration/context/

