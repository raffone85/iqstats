{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "build",
    "typeRoots": ["../../apps/web/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts", "asof/**/*.ts", "tests/**/*.ts"],
  "exclude": ["build", "node_modules"]
}
